{
 "scene": "B060",
 "cues": [
  {
   "id": "B060_f1_0",
   "file": 1,
   "chan": 0,
   "start": 2408,
   "end": 2904,
   "dur": 3.3,
   "speaker": "Chief",
   "en": "Эй! Никаких пьянок и обжорства за казённый счёт!",
   "enabled": true,
   "en_src": "Hey! No eating and drinking binges on expenses!"
  },
  {
   "id": "B060_f2_0",
   "file": 2,
   "chan": 0,
   "start": 2920,
   "end": 3336,
   "dur": 2.8,
   "speaker": "Gillian",
   "en": "О-о чём вы?",
   "enabled": true,
   "en_src": "W-what are you talking about?"
  },
  {
   "id": "B060_f3_0",
   "file": 3,
   "chan": 0,
   "start": 3352,
   "end": 3976,
   "dur": 4.2,
   "speaker": "Chief",
   "en": "Не прикидывайся. Метал Гир шлёт мне все данные.",
   "enabled": true,
   "en_src": "Don't play dumb. Metal Gear sends me all the data."
  },
  {
   "id": "B060_f4_0",
   "file": 4,
   "chan": 0,
   "start": 3992,
   "end": 4072,
   "dur": 0.5,
   "speaker": "Gillian",
   "en": "Метал?",
   "enabled": true,
   "en_src": "Metal?"
  },
  {
   "id": "B060_f5_0",
   "file": 5,
   "chan": 0,
   "start": 4088,
   "end": 4536,
   "dur": 3.0,
   "speaker": "Metal Gear",
   "en": "В-вот поэтому я тебя и предупреждал.",
   "enabled": true,
   "en_src": "Th-that's why I warned you."
  },
  {
   "id": "B060_f6_0",
   "file": 6,
   "chan": 0,
   "start": 4552,
   "end": 4824,
   "dur": 1.8,
   "speaker": "Chief",
   "en": "Чтоб больше такого не было.",
   "enabled": true,
   "last": true,
   "en_src": "Don't let it happen again."
  },
  {
   "id": "B060_008",
   "file": 11,
   "chan": 0,
   "start": 8040,
   "end": 8248,
   "dur": 1.4,
   "speaker": "Voice",
   "en": "Ты кто?",
   "enabled": true,
   "en_src": "Who are you?"
  },
  {
   "id": "B060_009",
   "file": 12,
   "chan": 0,
   "start": 8264,
   "end": 8632,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Я знаю Гибсона. Мне нужна информация.",
   "enabled": true,
   "en_src": "I know Gibson. I need information."
  },
  {
   "id": "B060_010",
   "file": 13,
   "chan": 0,
   "start": 8648,
   "end": 9092,
   "dur": 3.0,
   "speaker": "Napoleon",
   "en": "Ты тоже коп? Не верю я тебе.",
   "enabled": true,
   "en_src": "You a cop too? I don't trust you."
  },
  {
   "id": "B060_010b",
   "file": 13,
   "chan": 0,
   "start": 9388,
   "end": 9880,
   "dur": 3.3,
   "speaker": "Napoleon",
   "en": "Ладно, проверим пароль.",
   "enabled": true,
   "en_src": "All right, let's try the password."
  },
  {
   "id": "B060_011",
   "file": 14,
   "chan": 0,
   "start": 9896,
   "end": 9992,
   "dur": 0.6,
   "speaker": "Gillian",
   "en": "Пароль?",
   "enabled": true,
   "last": true,
   "en_src": "Password?"
  },
  {
   "id": "B060_000",
   "file": 63,
   "chan": 15,
   "start": 39735,
   "end": 40247,
   "dur": 3.4,
   "speaker": "Jamie",
   "en": "А, Гиллиан. Я спала.",
   "enabled": true,
   "last": true,
   "en_src": "Oh, Gillian. I was asleep."
  },
  {
   "id": "B060_001",
   "file": 64,
   "chan": 15,
   "start": 40263,
   "end": 40871,
   "dur": 4.1,
   "speaker": "Jamie",
   "en": "Алло, это Джейми. А, Гиллиан. Как ты?",
   "enabled": true,
   "last": true,
   "en_src": "Hello, Jamie here. Oh, Gillian. How are you?"
  },
  {
   "id": "B060_002",
   "file": 65,
   "chan": 15,
   "start": 40887,
   "end": 41415,
   "dur": 3.5,
   "speaker": "Jamie",
   "en": "Удивлён? Это запись.",
   "enabled": true,
   "last": true,
   "en_src": "Surprised? This is a recording."
  },
  {
   "id": "B060_003",
   "file": 67,
   "chan": 15,
   "start": 42839,
   "end": 43128,
   "dur": 1.9,
   "speaker": "Jamie",
   "en": "Меня сейчас нет.",
   "enabled": true,
   "en_src": "I'm out at the moment."
  },
  {
   "id": "B060_003b",
   "file": 67,
   "chan": 15,
   "start": 43271,
   "end": 44241,
   "dur": 13.0,
   "speaker": "Jamie",
   "en": "Звони в фармлабораторию Нео-Кобе, 39-1009.",
   "enabled": true,
   "en_src": "You can reach me at Neo Kobe Pharmaceutical Lab, 39-1009."
  },
  {
   "id": "B060_003c",
   "file": 67,
   "chan": 15,
   "start": 44431,
   "end": 44693,
   "dur": 1.7,
   "speaker": "Jamie",
   "en": "Прости, что напугала.",
   "enabled": true,
   "en_src": "Sorry for the surprise."
  },
  {
   "id": "B060_003d",
   "file": 67,
   "chan": 15,
   "start": 44765,
   "end": 44855,
   "dur": 0.6,
   "speaker": "Jamie",
   "en": "Пока!",
   "enabled": true,
   "last": true,
   "en_src": "Bye!"
  },
  {
   "id": "B060_004",
   "file": 68,
   "chan": 15,
   "start": 44871,
   "end": 45559,
   "dur": 4.6,
   "speaker": "Jamie",
   "en": "Алло, фармлаборатория Нео... О, Гиллиан! Что случилось?",
   "enabled": true,
   "last": true,
   "en_src": "Hello, Neo Kobe Pharma- Oh, Gillian! What's wrong?"
  },
  {
   "id": "B060_005",
   "file": 69,
   "chan": 15,
   "start": 45575,
   "end": 45869,
   "dur": 2.0,
   "speaker": "Jamie",
   "en": "Алло, фармлаборатория Нео-Кобе.",
   "enabled": true,
   "en_src": "Hello, Neo Kobe Pharmaceutical Lab."
  },
  {
   "id": "B060_005b",
   "file": 69,
   "chan": 15,
   "start": 46016,
   "end": 46375,
   "dur": 2.4,
   "speaker": "Jamie",
   "en": "А, это ты, Гиллиан.",
   "enabled": true,
   "last": true,
   "en_src": "Oh, it's you, Gillian."
  },
  {
   "id": "B060_006",
   "file": 70,
   "chan": 15,
   "start": 46391,
   "end": 46991,
   "dur": 8.0,
   "speaker": "Voice",
   "en": "Этот номер сейчас не обслуживается.",
   "enabled": true,
   "last": true,
   "en_src": "That number is not in service at this time."
  },
  {
   "id": "B060_006b",
   "file": 70,
   "chan": 15,
   "start": 46991,
   "end": 47591,
   "dur": 8.0,
   "speaker": "Voice",
   "en": "Проверьте номер и наберите снова.",
   "enabled": true,
   "last": true,
   "en_src": "Please check the number and dial again."
  },
  {
   "id": "B060_007",
   "file": 71,
   "chan": 15,
   "start": 47607,
   "end": 48234,
   "dur": 4.2,
   "speaker": "Voice",
   "en": "Набранный вами номер не обслуживается.",
   "enabled": true,
   "en_src": "The number you have dialed is not in service."
  },
  {
   "id": "B060_007b",
   "file": 71,
   "chan": 15,
   "start": 48347,
   "end": 48743,
   "dur": 2.6,
   "speaker": "Voice",
   "en": "Проверьте номер и попробуйте снова.",
   "enabled": true,
   "last": true,
   "en_src": "Please check the number and try again."
  },
  {
   "id": "B060_012",
   "file": 72,
   "chan": 15,
   "start": 48759,
   "end": 49455,
   "dur": 9.3,
   "speaker": "Clerk",
   "en": "Спасибо за звонок в \"Джой Дивижн\",",
   "enabled": true,
   "last": true,
   "en_src": "Thank you for calling Joy Division,"
  },
  {
   "id": "B060_012b",
   "file": 72,
   "chan": 15,
   "start": 49455,
   "end": 50151,
   "dur": 9.3,
   "speaker": "Clerk",
   "en": "магазин, где есть всё.",
   "enabled": true,
   "last": true,
   "en_src": "the store that has everything."
  },
  {
   "id": "B060_jcall_00",
   "file": 66,
   "chan": 15,
   "start": 41431,
   "end": 42321,
   "dur": 5.9,
   "speaker": "Metal Gear",
   "en": "Гиллиан, срочный звонок от Джейми. Соединяю.",
   "enabled": true,
   "en_src": "Gillian, an urgent call from Jamie. I'll connect you."
  },
  {
   "id": "B060_jcall_01",
   "file": 66,
   "chan": 15,
   "start": 42321,
   "end": 42823,
   "dur": 3.3,
   "speaker": "Jamie",
   "en": "Гиллиан, ко мне вернулась память!",
   "enabled": true,
   "last": true,
   "en_src": "Gillian, my memory's back!"
  }
 ],
