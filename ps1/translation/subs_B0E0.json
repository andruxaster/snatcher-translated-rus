   "chan": 1,
   "start": 14361,
   "end": 14729,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Ладно, попробуем. Ради расследования.",
   "enabled": true,
   "en_src": "All right, let's try some. For research."
