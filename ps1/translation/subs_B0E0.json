  {
   "id": "B0E0_020b",
   "file": 67,
   "chan": 1,
   "start": 38729,
   "end": 38937,
   "dur": 2.8,
   "speaker": "Gillian",
   "en": "Не надо мне от тебя пошлых историй.",
   "enabled": true,
   "last": true,
   "en_src": "No dirty stories from you."
  },
  {
   "id": "B0E0_103",
   "file": 19,
   "chan": 1,
   "start": 13641,
   "end": 14345,
   "dur": 4.7,
