{
 "scene": "B190",
 "options": {
  "menu_word": 4368,
  "rows": 3,
  "faceleft": true,
  "cols": 12
 },
 "cues": [
  {
   "id": "B190_f35_0",
   "file": 35,
   "chan": 4,
   "start": 27244,
   "end": 27500,
   "dur": 1.7,
   "speaker": "Gillian",
   "en": "Эй, это ты!",
   "enabled": true,
   "en_src": "Hey, it's you!"
  },
  {
   "id": "B190_f36_0",
   "file": 36,
   "chan": 4,
   "start": 27516,
   "end": 27852,
   "dur": 2.2,
   "speaker": "Napoleon",
   "en": "Узнал меня, да?",
   "enabled": true,
   "en_src": "You recognized me, huh?"
  },
  {
   "id": "B190_f37_0",
   "file": 37,
   "chan": 4,
   "start": 27868,
   "end": 28204,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Наполеон, что за наряд?",
   "enabled": true,
   "en_src": "Napoleon, what's with that outfit?"
  },
  {
   "id": "B190_f38_0",
   "file": 38,
   "chan": 4,
   "start": 28220,
   "end": 28953,
   "dur": 4.7,
   "speaker": "Napoleon",
   "en": "В смысле \"что за наряд\"? Я завязываю.",
   "enabled": true,
   "en_src": "What do you mean, what's with it? I'm quitting."
  },
  {
   "id": "B190_f38_0b",
   "file": 38,
   "chan": 4,
   "start": 28953,
   "end": 29738,
   "dur": 5.4,
   "speaker": "Napoleon",
   "en": "Слишком опасная работа. Кажется, за мной охотятся.",
   "enabled": true,
   "en_src": "This work's too dangerous. I think someone's after me."
  },
  {
   "id": "B190_f38_0c",
   "file": 38,
   "chan": 4,
   "start": 29738,
   "end": 30236,
   "dur": 3.2,
   "speaker": "Napoleon",
   "en": "Меня убьют, как Гибсона.",
   "enabled": true,
   "en_src": "I'll be killed just like Gibson."
  },
  {
   "id": "B190_f39_0",
   "file": 39,
   "chan": 4,
   "start": 30252,
   "end": 30716,
   "dur": 3.1,
   "speaker": "Napoleon",
   "en": "С меня хватит. Давай на этом закончим.",
   "enabled": true,
   "en_src": "I've had enough. Let's call it quits."
  },
  {
   "id": "B190_f40_0",
   "file": 40,
   "chan": 4,
   "start": 30732,
   "end": 31212,
   "dur": 3.2,
   "speaker": "Gillian",
   "en": "Постой, Наполеон. Я защищу тебя от снатчеров.",
   "enabled": true,
   "en_src": "Wait, Napoleon. I'll protect you from the Snatchers."
  },
  {
   "id": "B190_f41_0",
   "file": 41,
   "chan": 4,
   "start": 31228,
   "end": 31852,
   "dur": 8.4,
   "speaker": "Napoleon",
   "en": "Мы оба мишени. Берегись снатчеров.",
   "enabled": true,
   "en_src": "We're both targets. Watch out for the Snatchers."
  },
  {
   "id": "B190_f42_0",
   "file": 42,
   "chan": 4,
   "start": 31868,
   "end": 32444,
   "dur": 3.8,
   "speaker": "Napoleon",
   "en": "Вот, держи. Подарок на Рождество.",
   "enabled": true,
   "en_src": "Here, take this. A Christmas present."
  },
  {
   "id": "B190_f43_0",
   "file": 43,
   "chan": 4,
   "start": 32460,
   "end": 32668,
   "dur": 1.4,
   "speaker": "Gillian",
   "en": "Что? Салфетки?",
   "enabled": true,
   "en_src": "What? Tissues?"
  },
  {
   "id": "B190_f44_0",
   "file": 44,
   "chan": 4,
   "start": 32684,
   "end": 33036,
   "dur": 2.3,
   "speaker": "Napoleon",
   "en": "Бывай. Счастливого Рождества!",
   "enabled": true,
   "en_src": "See you. Merry Christmas!"
  },
  {
   "id": "B190_f45_0",
   "file": 45,
   "chan": 4,
   "start": 33052,
   "end": 33324,
   "dur": 1.8,
   "speaker": "Metal Gear",
   "en": "Наполеон ушёл домой.",
   "enabled": true,
   "last": true,
   "en_src": "Napoleon has gone home."
  },
  {
   "id": "B190_c4f46_0",
   "file": 46,
   "chan": 4,
   "start": 33340,
   "end": 33766,
   "dur": 2.8,
   "speaker": "Gillian",
   "en": "Неудивительно, что он боится.",
   "enabled": true,
   "en_src": "Can't blame him for being scared."
  },
  {
   "id": "B190_c4f46_0b",
   "file": 46,
   "chan": 4,
   "start": 33869,
   "end": 34108,
   "dur": 1.6,
   "speaker": "Gillian",
   "en": "Зато мы получили нужные ответы.",
   "enabled": true,
   "en_src": "We got the answers we needed, anyway."
  },
  {
   "id": "B190_c4f47_0",
   "file": 47,
   "chan": 4,
   "start": 34124,
   "end": 34476,
   "dur": 4.6,
   "speaker": "Metal Gear",
   "en": "На обороте салфеток реклама.",
   "enabled": true,
   "en_src": "There's an ad on the back of the tissues."
  },
  {
   "id": "B190_c4f48_0",
   "file": 48,
   "chan": 4,
   "start": 34492,
   "end": 35212,
   "dur": 4.8,
   "speaker": "Gillian",
   "en": "Реклама \"Аутер Хэвен\"! Он и этим занимается?",
   "enabled": true,
   "last": true,
   "en_src": "An ad for Outer Heaven! He does this too?"
  },
  {
   "id": "B190_c4f49_0",
   "file": 49,
   "chan": 4,
   "start": 35228,
   "end": 35484,
   "dur": 1.7,
   "speaker": "Metal Gear",
   "en": "О, лоток с удоном!",
   "enabled": true,
   "en_src": "Oh, there's an udon stand!"
  },
  {
   "id": "B190_c4f50_0",
   "file": 50,
   "chan": 4,
   "start": 35500,
   "end": 35660,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Давай перекусим.",
   "enabled": true,
   "en_src": "Let's get something to eat."
  },
  {
   "id": "B190_c4f51_0",
   "file": 51,
   "chan": 4,
   "start": 35676,
   "end": 36172,
   "dur": 3.3,
   "speaker": "Metal Gear",
   "en": "Мест нет. Придётся немного подождать.",
   "enabled": true,
   "en_src": "No seats free. We'll have to wait a little."
  },
  {
   "id": "B190_c4f52_0",
   "file": 52,
   "chan": 4,
   "start": 36188,
   "end": 36780,
   "dur": 3.9,
   "speaker": "Cook",
   "en": "Место свободно! Заходите! Добро пожаловать!",
   "enabled": true,
   "en_src": "Seats open! Come on in! Welcome!"
  },
  {
   "id": "B190_c4f53_0",
   "file": 53,
   "chan": 4,
   "start": 36796,
   "end": 37132,
   "dur": 2.2,
   "speaker": "Metal Gear",
   "en": "Похоже, место освободилось. Идём.",
   "enabled": true,
   "en_src": "Looks like a seat opened up. Let's go."
  },
  {
   "id": "B190_c4f54_0",
   "file": 54,
   "chan": 4,
   "start": 37148,
   "end": 37468,
   "dur": 2.1,
   "speaker": "Cook",
   "en": "Ну, что будете?",
   "enabled": true,
   "en_src": "Come on, what'll you have?"
  },
  {
   "id": "B190_c4f55_0",
   "file": 55,
   "chan": 4,
   "start": 37484,
   "end": 37644,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Дайте мне четыре вот этих.",
   "enabled": true,
   "en_src": "Give me four of those."
  },
  {
   "id": "B190_c4f56_0",
   "file": 56,
   "chan": 4,
   "start": 37660,
   "end": 37900,
   "dur": 1.6,
   "speaker": "Cook",
   "en": "Двух хватит.",
   "enabled": true,
   "en_src": "Two is plenty."
  },
  {
   "id": "B190_c4f57_0",
   "file": 57,
   "chan": 4,
   "start": 37916,
   "end": 38044,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Нет, четыре.",
   "enabled": true,
   "en_src": "No, four."
  },
  {
   "id": "B190_c4f58_0",
   "file": 58,
   "chan": 4,
   "start": 38060,
   "end": 38332,
   "dur": 1.8,
   "speaker": "Cook",
   "en": "Двух хватит!",
   "enabled": true,
   "en_src": "Two is plenty!"
  },
  {
   "id": "B190_c4f59_0",
   "file": 59,
   "chan": 4,
   "start": 38348,
   "end": 38460,
   "dur": 0.7,
   "speaker": "Gillian",
   "en": "И удон!",
   "enabled": true,
   "en_src": "And udon!"
  },
  {
   "id": "B190_c4f60_0",
   "file": 60,
   "chan": 4,
   "start": 38476,
   "end": 38748,
   "dur": 1.8,
   "speaker": "Cook",
   "en": "Да будьте благоразумны!",
   "enabled": true,
   "en_src": "Come on, be reasonable!"
  },
  {
   "id": "B190_c4f61_0",
   "file": 61,
   "chan": 4,
   "start": 38764,
   "end": 39164,
   "dur": 2.7,
   "speaker": "Gillian",
   "en": "Жена говорила, что я много ем.",
   "enabled": true,
   "en_src": "My wife used to say I ate a lot."
  },
  {
   "id": "B190_c4f62_0",
   "file": 62,
   "chan": 4,
   "start": 39180,
   "end": 39474,
   "dur": 2.0,
   "speaker": "Metal Gear",
   "en": "Гиллиан, ешь быстрее. Нам пора.",
   "enabled": true,
   "en_src": "Gillian, hurry up and eat. We should go."
  },
  {
   "id": "B190_c4f62_0b",
   "file": 62,
   "chan": 4,
   "start": 39736,
   "end": 39996,
   "dur": 1.5,
   "speaker": "Metal Gear",
   "en": "Давай, скорее. Ну же.",
   "enabled": true,
   "en_src": "Come on, hurry. Come on."
  },
  {
   "id": "B190_c4f63_0",
   "file": 63,
   "chan": 4,
   "start": 40012,
   "end": 40348,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Ладно. Идём.",
   "enabled": true,
   "last": true,
   "en_src": "All right. Let's go."
  },
  {
   "id": "B190_c4f64_0",
   "file": 64,
   "chan": 4,
   "start": 40364,
   "end": 41052,
   "dur": 4.6,
   "speaker": "Teller",
   "en": "Опять вы! Я знала, что вернётесь.",
   "enabled": true,
   "en_src": "You again! I knew you'd come back."
  },
  {
   "id": "B190_c4f65_0",
   "file": 65,
   "chan": 4,
   "start": 41068,
   "end": 41228,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Не по своей воле.",
   "enabled": true,
   "en_src": "Not because I wanted to."
  },
  {
   "id": "B190_c4f66_0",
   "file": 66,
   "chan": 4,
   "start": 41244,
   "end": 41820,
   "dur": 3.8,
   "speaker": "Teller",
   "en": "Раз вернулись - значит, верите. Что сегодня?",
   "enabled": true,
   "en_src": "Coming back proves you believe me. What is it today?"
  },
  {
   "id": "B190_c4f67_0",
   "file": 67,
   "chan": 4,
   "start": 41836,
   "end": 41964,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Пропавший человек.",
   "enabled": true,
   "en_src": "A missing person."
  },
  {
   "id": "B190_c4f68_0",
   "file": 68,
   "chan": 4,
   "start": 41980,
   "end": 42046,
   "dur": 0.6,
   "speaker": "Teller",
   "en": "Кто?",
   "enabled": true,
   "en_src": "Who?"
  },
  {
   "id": "B190_c4f68_0b",
   "file": 68,
   "chan": 4,
   "start": 42046,
   "end": 42636,
   "dur": 8.2,
   "speaker": "Teller",
   "en": "Есть фото, рисунок сетчатки, ID, хоть что-нибудь?",
   "enabled": true,
   "en_src": "Do you have a photo, a retinal pattern, an ID, anything?"
  },
  {
   "id": "B190_c4f69_0",
   "file": 69,
   "chan": 4,
   "start": 42652,
   "end": 43372,
   "dur": 9.6,
   "speaker": "Metal Gear",
   "en": "У меня есть её данные. Переброшу на ваш терминал.",
   "enabled": true,
   "en_src": "I have her data. I'll transfer it to your terminal."
  },
  {
   "id": "B190_c4f70_0",
   "file": 70,
   "chan": 4,
   "start": 43388,
   "end": 43516,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Совсем немного.",
   "enabled": true,
   "en_src": "Just a little."
  },
  {
   "id": "B190_c4f71_0",
   "file": 71,
   "chan": 4,
   "start": 43532,
   "end": 44460,
   "dur": 6.2,
   "speaker": "Teller",
   "en": "Есть. Кэтрин, да? Сейчас погадаю.",
   "enabled": true,
   "en_src": "Got it. Catherine, is it? Let me read her fortune."
  },
  {
   "id": "B190_c4f72_0",
   "file": 72,
   "chan": 4,
   "start": 44476,
   "end": 44636,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Метал, давай просто уйдём!",
   "enabled": true,
   "en_src": "Metal, let's just leave!"
  },
  {
   "id": "B190_c4f73_0",
   "file": 73,
   "chan": 4,
   "start": 44652,
   "end": 44799,
   "dur": 1.0,
   "speaker": "Teller",
   "en": "Тихо!",
   "enabled": true,
   "en_src": "Quiet!"
  },
  {
   "id": "B190_c4f73_0b",
   "file": 73,
   "chan": 4,
   "start": 44945,
   "end": 45092,
   "dur": 1.0,
   "speaker": "Teller",
   "en": "Хм-м-м-м-м!",
   "enabled": true,
   "en_src": "Hnnnnngh!"
  },
  {
   "id": "B190_c4f73_0c",
   "file": 73,
   "chan": 4,
   "start": 45239,
   "end": 45356,
   "dur": 0.8,
   "speaker": "Teller",
   "en": "Вижу.",
   "enabled": true,
   "en_src": "I have it."
  },
  {
   "id": "B190_c4f74_0",
   "file": 74,
   "chan": 4,
   "start": 45372,
   "end": 45532,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Где она?",
   "enabled": true,
   "en_src": "Where is she?"
  },
  {
   "id": "B190_c4f75_0",
   "file": 75,
   "chan": 4,
   "start": 45548,
   "end": 46188,
   "dur": 4.3,
   "speaker": "Teller",
   "en": "Рядом с вами. Совсем близко.",
   "enabled": true,
   "en_src": "Right near you. She's very close."
  },
  {
   "id": "B190_c4f76_0",
   "file": 76,
   "chan": 4,
   "start": 46204,
   "end": 46316,
   "dur": 0.7,
   "speaker": "Gillian",
   "en": "Не несите чушь!",
   "enabled": true,
   "en_src": "Don't talk nonsense!"
  },
  {
   "id": "B190_c4f77_0",
   "file": 77,
   "chan": 4,
   "start": 46332,
   "end": 46524,
   "dur": 1.3,
   "speaker": "Teller",
   "en": "Я не вру!",
   "enabled": true,
   "en_src": "I'm not lying!"
  },
  {
   "id": "B190_c4f78_0",
   "file": 78,
   "chan": 4,
   "start": 46540,
   "end": 46668,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Доказательства?",
   "enabled": true,
   "en_src": "What proof?"
  },
  {
   "id": "B190_c4f79_0",
   "file": 79,
   "chan": 4,
   "start": 46684,
   "end": 47136,
   "dur": 3.0,
   "speaker": "Teller",
   "en": "А так поверите?",
   "enabled": true,
   "en_src": "Would you believe me if I put it this way?"
  },
  {
   "id": "B190_c4f79_0b",
   "file": 79,
   "chan": 4,
   "start": 47332,
   "end": 47466,
   "dur": 2.7,
   "speaker": "Teller",
   "en": "Несколько часов назад",
   "enabled": true,
   "en_src": "A few hours ago,"
  },
  {
   "id": "B190_c4f79_0bb",
   "file": 79,
   "chan": 4,
   "start": 47466,
   "end": 48088,
   "dur": 8.9,
   "speaker": "Teller",
   "en": "эта девушка пользовалась уличным терминалом у вашего дома.",
   "enabled": true,
   "en_src": "this girl used a public terminal near your apartment."
  },
  {
   "id": "B190_c4f79_0bc",
   "file": 79,
   "chan": 4,
   "start": 48088,
   "end": 48492,
   "dur": 3.9,
   "speaker": "Teller",
   "en": "Это записано.",
   "enabled": true,
   "en_src": "There's a record of it."
  },
  {
   "id": "B190_c5f1",
   "file": 1,
   "chan": 5,
   "start": 2413,
   "end": 3069,
   "dur": 4.4,
   "speaker": "Metal Gear",
   "en": "Может, тогда Кэтрин и звонила в штаб?",
   "enabled": true,
   "en_src": "Could that be when Catherine called headquarters?"
  },
  {
   "id": "B190_c5f2",
   "file": 2,
   "chan": 5,
   "start": 3085,
   "end": 3453,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Откуда у вас эта информация?",
   "enabled": true,
   "en_src": "Where did you get that information?"
  },
  {
   "id": "B190_c5f3",
   "file": 3,
   "chan": 5,
   "start": 3469,
   "end": 3885,
   "dur": 2.8,
   "speaker": "Teller",
   "en": "Из телефонной компании. Довольны?",
   "enabled": true,
   "en_src": "The phone company. Satisfied?"
  },
  {
   "id": "B190_c5f4",
   "file": 4,
   "chan": 5,
   "start": 3901,
   "end": 4429,
   "dur": 3.5,
   "speaker": "Gillian",
   "en": "Впечатляет. Вы осведомлённее штаба!",
   "enabled": true,
   "en_src": "I'm impressed. Better informed than headquarters!"
  },
  {
   "id": "B190_c5f5",
   "file": 5,
   "chan": 5,
   "start": 4445,
   "end": 4816,
   "dur": 2.5,
   "speaker": "Teller",
   "en": "Гадание - это всё в голове!",
   "enabled": true,
   "en_src": "Fortune telling is all in the mind!"
  },
  {
   "id": "B190_c5f5b",
   "file": 5,
   "chan": 5,
   "start": 4913,
   "end": 5007,
   "dur": 0.6,
   "speaker": "Teller",
   "en": "Хмф!",
   "enabled": true,
   "en_src": "Hmph!"
  },
  {
   "id": "B190_c5f5c",
   "file": 5,
   "chan": 5,
   "start": 5093,
   "end": 5277,
   "dur": 1.2,
   "speaker": "Teller",
   "en": "Заходите ещё!",
   "enabled": true,
   "en_src": "Come again!"
  },
  {
   "id": "B190_c5f6",
   "file": 6,
   "chan": 5,
   "start": 5293,
   "end": 5789,
   "dur": 3.3,
   "speaker": "Gillian",
   "en": "Ну и гадалка. Она хакер, торгующий информацией!",
   "enabled": true,
   "en_src": "Some fortune teller. She's a hacker selling information!"
  },
  {
   "id": "B190_c5f7",
