{
 "scene": "B1F0",
 "options": {
  "menu_word": 784,
  "rows": 3,
  "faceleft": true,
  "cols": 12
 },
 "cues": [
  {
   "id": "B1F0_f24_0",
   "file": 24,
   "chan": 6,
   "start": 18094,
   "end": 18286,
   "dur": 1.3,
   "speaker": "Gillian",
   "en": "Куда ты нас везёшь?",
   "enabled": true,
   "en_src": "Where are you taking us?"
  },
  {
   "id": "B1F0_f25_0",
   "file": 25,
   "chan": 6,
   "start": 18302,
   "end": 18766,
   "dur": 3.1,
   "speaker": "Metal Gear",
   "en": "Что-то не так. Трицикл не слушается.",
   "enabled": true,
   "en_src": "Something's wrong. The Tricycle is out of control."
  },
  {
   "id": "B1F0_f26_0",
   "file": 26,
   "chan": 6,
   "start": 18782,
   "end": 19006,
   "dur": 1.5,
   "speaker": "Gillian",
   "en": "Переключи с автопилота на ручное!",
   "enabled": true,
   "en_src": "Switch from autopilot to manual!"
  },
  {
   "id": "B1F0_f27_0",
   "file": 27,
   "chan": 6,
   "start": 19022,
   "end": 19518,
   "dur": 3.3,
   "speaker": "Metal Gear",
   "en": "Понял. Переключено на ручное управление.",
   "enabled": true,
   "en_src": "Understood. Switched to manual control."
  },
  {
   "id": "B1F0_f28_0",
   "file": 28,
   "chan": 6,
   "start": 19534,
   "end": 19630,
   "dur": 0.6,
   "speaker": "Metal Gear",
   "en": "Ну как?",
   "enabled": true,
   "en_src": "How is it?"
  },
  {
   "id": "B1F0_f29_0",
   "file": 29,
   "chan": 6,
   "start": 19646,
   "end": 19982,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Отказали! Тормозов нет!",
   "enabled": true,
   "en_src": "They're gone! No brakes!"
  },
  {
   "id": "B1F0_f30_0",
   "file": 30,
   "chan": 6,
   "start": 19998,
   "end": 20398,
   "dur": 2.7,
   "speaker": "Gillian",
   "en": "Метал! Проверь тормоза! Быстрее!",
   "enabled": true,
   "en_src": "Metal! Check the brakes! Hurry!"
  },
  {
   "id": "B1F0_f31_0",
   "file": 31,
   "chan": 6,
   "start": 20414,
   "end": 20718,
   "dur": 2.0,
   "speaker": "Metal Gear",
   "en": "Наверное, их испортил снатчер!",
   "enabled": true,
   "en_src": "A Snatcher must have sabotaged them!"
  },
  {
   "id": "B1F0_f32_0",
   "file": 32,
   "chan": 6,
   "start": 20734,
   "end": 21278,
   "dur": 7.2,
   "speaker": "Gillian",
   "en": "Испортил? Ну конечно! Трицикл мог испортить только один человек!",
   "enabled": true,
   "en_src": "Sabotage? Of course! Only one person could sabotage the Tricycle!"
  },
  {
   "id": "B1F0_f33_0",
   "file": 33,
   "chan": 6,
   "start": 21294,
   "end": 21822,
   "dur": 3.5,
   "speaker": "Metal Gear",
   "en": "Не до того! Сделай что-нибудь, Гиллиан!",
   "enabled": true,
   "last": true,
   "en_src": "Never mind that! Do something, Gillian!"
  },
  {
   "id": "B1F0_r_00",
   "file": 3,
   "chan": 6,
   "start": 78158,
   "end": 78800,
   "dur": 4.3,
   "speaker": "Gillian",
   "en": "Была не была! Метал, по моему сигналу выставь ноги!",
   "enabled": true,
   "en_src": "To hell with it! Metal, put your feet out on my signal!"
  },
  {
   "id": "B1F0_r_01",
   "file": 3,
   "chan": 6,
   "start": 78800,
   "end": 78955,
   "dur": 1.0,
   "speaker": "Metal Gear",
   "en": "Ноги?",
   "enabled": true,
   "en_src": "Our feet?"
  },
  {
   "id": "B1F0_r_02",
   "file": 3,
   "chan": 6,
   "start": 78955,
   "end": 80364,
   "dur": 8.2,
   "speaker": "Gillian",
   "en": "Готов? Раз, два, три! Ай! Горячо! Метал, бесполезно!",
   "enabled": true,
   "en_src": "Ready? Here goes! One, two, three! Ow! Hot! Metal, it's no good!"
  },
  {
   "id": "B1F0_r_02b",
   "file": 3,
   "chan": 6,
   "start": 80364,
   "end": 80454,
   "dur": 1.8,
   "speaker": "Gillian",
   "en": "Нам не остановиться!",
   "enabled": true,
   "en_src": "We can't stop!"
  },
  {
   "id": "B1F0_r_05",
   "file": 3,
   "chan": 6,
   "start": 80454,
   "end": 80865,
   "dur": 5.5,
   "speaker": "Metal Gear",
   "en": "Гиллиан! Через 500 метров крутой поворот!",
   "enabled": true,
   "en_src": "Gillian! There's a sharp bend in 500 meters!"
  },
  {
   "id": "B1F0_r_05b",
   "file": 3,
   "chan": 6,
   "start": 80865,
   "end": 81276,
   "dur": 5.5,
   "speaker": "Metal Gear",
   "en": "На такой скорости нам его не пройти!",
   "enabled": true,
   "en_src": "We can't make the turn at this speed!"
  },
  {
   "id": "B1F0_r_06",
   "file": 3,
   "chan": 6,
   "start": 81276,
   "end": 81761,
   "dur": 3.2,
   "speaker": "Randam",
   "en": "Гиллиан! Гиллиан! Эй, Гиллиан!",
   "enabled": true,
   "en_src": "Gillian! Gillian! Hey, Gillian!"
  },
  {
   "id": "B1F0_r_08",
   "file": 3,
   "chan": 6,
   "start": 81761,
   "end": 81959,
   "dur": 1.3,
   "speaker": "Gillian",
   "en": "А?",
   "enabled": true,
   "en_src": "Huh?"
  },
  {
   "id": "B1F0_r_09",
   "file": 3,
   "chan": 6,
   "start": 81959,
   "end": 82157,
   "dur": 1.3,
   "speaker": "Randam",
   "en": "Эй! Сюда!",
   "enabled": true,
   "en_src": "Hey! Over here!"
  },
  {
   "id": "B1F0_r_10",
   "file": 3,
   "chan": 6,
   "start": 82157,
   "end": 82397,
   "dur": 1.6,
   "speaker": "Gillian",
   "en": "Что?",
   "enabled": true,
   "en_src": "What?"
  },
  {
   "id": "B1F0_r_11",
   "file": 3,
   "chan": 6,
   "start": 82397,
   "end": 82805,
   "dur": 2.7,
   "speaker": "Randam",
   "en": "Сюда, Гиллиан!",
   "enabled": true,
   "en_src": "Over here, Gillian!"
  },
  {
   "id": "B1F0_r_12",
   "file": 3,
   "chan": 6,
   "start": 82805,
   "end": 83728,
   "dur": 6.2,
   "speaker": "Gillian",
   "en": "Рэндам!",
   "enabled": true,
   "en_src": "Randam!"
  },
  {
   "id": "B1F0_r_13",
   "file": 3,
   "chan": 6,
   "start": 83728,
   "end": 84070,
   "dur": 2.3,
   "speaker": "Randam",
   "en": "Прыгай сюда, Гиллиан! Быстрее!",
   "enabled": true,
   "en_src": "Jump over here, Gillian! Hurry!"
  },
  {
   "id": "B1F0_r_14",
   "file": 3,
   "chan": 6,
   "start": 84070,
   "end": 84370,
   "dur": 2.0,
   "speaker": "Metal Gear",
   "en": "До поворота триста метров!",
   "enabled": true,
   "en_src": "Three hundred meters to the bend!"
  },
  {
   "id": "B1F0_r_15",
   "file": 3,
   "chan": 6,
   "start": 84370,
   "end": 84597,
   "dur": 1.5,
   "speaker": "Gillian",
   "en": "Ты первый, Метал!",
   "enabled": true,
   "en_src": "You go first, Metal!"
  },
  {
   "id": "B1F0_r_16",
   "file": 3,
   "chan": 6,
   "start": 84597,
   "end": 85077,
   "dur": 3.2,
   "speaker": "Metal Gear",
   "en": "Нет! Только не опять прыгать!",
   "enabled": true,
   "en_src": "No! Not another jump!"
  },
  {
   "id": "B1F0_r_17",
   "file": 3,
   "chan": 6,
   "start": 85077,
   "end": 85329,
   "dur": 1.7,
   "speaker": "Randam",
   "en": "Быстрее! Поворот близко!",
   "enabled": true,
   "en_src": "Hurry! The bend's coming!"
  },
  {
   "id": "B1F0_r_18",
   "file": 3,
   "chan": 6,
   "start": 85329,
   "end": 85958,
   "dur": 4.2,
   "speaker": "Metal Gear",
   "en": "Ладно! Поехали!",
   "enabled": true,
   "en_src": "All right! Here goes!"
  },
  {
   "id": "B1F0_r_20",
   "file": 3,
   "chan": 6,
   "start": 85958,
   "end": 86552,
   "dur": 4.0,
   "speaker": "Randam",
   "en": "Так, Гиллиан! Твоя очередь! Держи курс!",
   "enabled": true,
   "en_src": "All right, Gillian! Your turn! Hold your course!"
  },
  {
   "id": "B1F0_r_21",
   "file": 3,
   "chan": 6,
   "start": 86552,
   "end": 86852,
   "dur": 2.0,
   "speaker": "Metal Gear",
   "en": "Осталось сто метров!",
   "enabled": true,
   "en_src": "One hundred meters left!"
  },
  {
   "id": "B1F0_r_22",
   "file": 3,
   "chan": 6,
   "start": 86852,
   "end": 87002,
   "dur": 1.0,
   "speaker": "Randam",
   "en": "Прыгай, Гиллиан!",
   "enabled": true,
   "en_src": "Jump, Gillian!"
  },
  {
   "id": "B1F0_r_23",
   "file": 3,
   "chan": 6,
   "start": 87002,
   "end": 87451,
   "dur": 3.0,
   "speaker": "Gillian",
   "en": "Не могу! Не могу поймать момент!",
   "enabled": true,
   "en_src": "I can't! I can't time it!"
  },
  {
   "id": "B1F0_r_24",
   "file": 3,
   "chan": 6,
   "start": 87451,
   "end": 87751,
   "dur": 2.0,
   "speaker": "Metal Gear",
   "en": "Пятьдесят метров!",
   "enabled": true,
   "en_src": "Fifty meters!"
  },
  {
   "id": "B1F0_r_25",
   "file": 3,
   "chan": 6,
   "start": 87751,
   "end": 87901,
   "dur": 1.0,
   "speaker": "Randam",
   "en": "Быстрее, Гиллиан!",
   "enabled": true,
   "en_src": "Hurry, Gillian!"
  },
  {
   "id": "B1F0_r_26",
   "file": 3,
   "chan": 6,
   "start": 87901,
   "end": 88051,
   "dur": 1.0,
   "speaker": "Metal Gear",
   "en": "Тридцать метров!",
   "enabled": true,
   "en_src": "Thirty meters!"
  },
  {
   "id": "B1F0_r_27",
   "file": 3,
   "chan": 6,
   "start": 88051,
   "end": 88351,
   "dur": 2.0,
   "speaker": "Randam",
   "en": "Быстрее! Быстрее!",
   "enabled": true,
   "en_src": "Hurry! Hurry!"
  },
  {
   "id": "B1F0_r_28",
   "file": 3,
   "chan": 6,
   "start": 88351,
   "end": 88651,
   "dur": 2.0,
   "speaker": "Gillian",
   "en": "Бесполезно!",
   "enabled": true,
   "en_src": "It's no use!"
  },
  {
   "id": "B1F0_r_29",
   "file": 3,
   "chan": 6,
   "start": 88651,
   "end": 89502,
   "dur": 5.7,
   "speaker": "Randam",
   "en": "Давай!",
   "enabled": true,
   "last": true,
   "en_src": "Now!"
  },
  {
   "id": "B1F0_j_00",
   "file": 4,
   "chan": 4,
   "start": 68965,
   "end": 69474,
   "dur": 3.3,
   "speaker": "Jamie",
   "en": "Гиллиан, это я. Слушай внимательно.",
   "enabled": true,
   "en_src": "Gillian, it's me. Listen carefully."
  },
  {
   "id": "B1F0_j_00b",
   "file": 4,
   "chan": 4,
   "start": 69474,
   "end": 69813,
   "dur": 4.1,
   "speaker": "Jamie",
   "en": "В больнице \"Куин\" шла большая стройка",
   "enabled": true,
   "en_src": "Queen Hospital underwent major construction"
  },
  {
   "id": "B1F0_j_00c",
   "file": 4,
   "chan": 4,
   "start": 69813,
   "end": 70875,
   "dur": 5.6,
   "speaker": "Jamie",
   "en": "в 2030 году - расширяли подземные помещения. Да.",
   "enabled": true,
   "en_src": "in 2030 to expand its underground facilities. That's right."
  },
  {
   "id": "B1F0_j_00d",
   "file": 4,
   "chan": 4,
   "start": 70875,
   "end": 71322,
   "dur": 3.6,
   "speaker": "Jamie",
   "en": "У больницы есть подземный этаж.",
   "enabled": true,
   "en_src": "The hospital has an underground level."
  },
  {
   "id": "B1F0_j_00e",
   "file": 4,
   "chan": 4,
   "start": 71322,
   "end": 71752,
   "dur": 4.6,
   "speaker": "Jamie",
   "en": "В Нео-Кобе под землёй почти не строят.",
   "enabled": true,
   "en_src": "Underground construction is unusual in Neo Kobe."
  },
  {
   "id": "B1F0_j_00f",
   "file": 4,
   "chan": 4,
   "start": 71752,
   "end": 72370,
   "dur": 4.2,
   "speaker": "Jamie",
   "en": "Поэтому сохранилась запись. Это не всё.",
   "enabled": true,
   "en_src": "That's why there was a record. There's more."
  },
  {
   "id": "B1F0_j_00g",
   "file": 4,
   "chan": 4,
   "start": 72370,
   "end": 72720,
   "dur": 5.5,
   "speaker": "Jamie",
   "en": "Директора, Чин Шу Хо, однажды отстраняли от практики",
   "enabled": true,
   "en_src": "The director, Chin Shu Ho, once had his practice suspended"
  },
  {
   "id": "B1F0_j_00h",
   "file": 4,
   "chan": 4,
   "start": 72720,
   "end": 73300,
   "dur": 4.8,
   "speaker": "Jamie",
   "en": "за незаконные операции суррогатного материнства",
   "enabled": true,
   "en_src": "for performing illegal surrogate-mother operations"
  },
  {
   "id": "B1F0_j_00i",
   "file": 4,
   "chan": 4,
   "start": 73300,
   "end": 73850,
   "dur": 2.6,
   "speaker": "Jamie",
   "en": "в подземном помещении.",
   "enabled": true,
   "en_src": "in an underground facility."
  },
  {
   "id": "B1F0_j_03",
   "file": 4,
   "chan": 4,
   "start": 73850,
   "end": 74228,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Значит, под землёй есть клиника.",
   "enabled": true,
   "en_src": "So there's a treatment facility underground."
  },
  {
   "id": "B1F0_j_04",
   "file": 4,
   "chan": 4,
   "start": 74228,
   "end": 74298,
   "dur": 1.0,
   "speaker": "Metal Gear",
   "en": "Именно.",
   "enabled": true,
   "en_src": "Exactly."
  },
  {
   "id": "B1F0_j_04b",
   "file": 4,
   "chan": 4,
   "start": 74298,
   "end": 74965,
   "dur": 8.8,
   "speaker": "Metal Gear",
   "en": "Чин Шу Хо обслуживает снатчеров в подземной клинике.",
   "enabled": true,
   "en_src": "Chin Shu Ho is servicing the Snatchers in the underground facility."
  },
  {
   "id": "B1F0_j_05",
   "file": 4,
   "chan": 4,
   "start": 74965,
   "end": 75425,
   "dur": 5.3,
   "speaker": "Gillian",
   "en": "Значит, Чин тоже снатчер.",
   "enabled": true,
   "en_src": "Then Chin is a Snatcher too."
  },
  {
   "id": "B1F0_j_05b",
   "file": 4,
   "chan": 4,
   "start": 75425,
   "end": 75988,
   "dur": 8.3,
   "speaker": "Gillian",
   "en": "Его, видно, подменили, чтобы заполучить клинику.",
   "enabled": true,
   "en_src": "They must have snatched him to get access to his facilities."
  },
  {
   "id": "B1F0_j_06",
   "file": 4,
   "chan": 4,
   "start": 75988,
   "end": 76671,
   "dur": 4.6,
   "speaker": "Metal Gear",
   "en": "А наземная больница - прикрытие.",
   "enabled": true,
   "en_src": "The facilities above ground are a cover for it."
  },
  {
   "id": "B1F0_j_07",
   "file": 4,
   "chan": 4,
   "start": 76671,
   "end": 77247,
   "dur": 3.7,
   "speaker": "Gillian",
   "en": "Если ударим по больнице, остановим их наступление.",
   "enabled": true,
   "en_src": "If we hit this hospital, we can stop their advance."
  },
  {
   "id": "B1F0_j_07b",
   "file": 4,
   "chan": 4,
   "start": 77247,
   "end": 77898,
   "dur": 4.4,
   "speaker": "Gillian",
   "en": "Вот и всё, Метал. Идём на базу снатчеров.",
   "enabled": true,
   "en_src": "This is it, Metal. We're going into the Snatchers' base."
  },
  {
   "id": "B1F0_j_08",
   "file": 4,
   "chan": 4,
   "start": 77898,
   "end": 78009,
   "dur": 0.7,
   "speaker": "Jamie",
   "en": "Гиллиан.",
   "enabled": true,
   "en_src": "Gillian."
  },
  {
   "id": "B1F0_j_09",
   "file": 4,
   "chan": 4,
   "start": 78009,
   "end": 78243,
   "dur": 1.6,
   "speaker": "Gillian",
   "en": "Хм?",
   "enabled": true,
   "en_src": "Hmm?"
  },
  {
   "id": "B1F0_j_10",
   "file": 4,
   "chan": 4,
   "start": 78243,
   "end": 79379,
   "dur": 7.6,
   "speaker": "Jamie",
   "en": "Это опасная работа, да? Вернись живым.",
   "enabled": true,
   "en_src": "It's dangerous work, isn't it? I want you to come back safely."
  },
  {
   "id": "B1F0_j_11",
   "file": 4,
   "chan": 4,
   "start": 79379,
   "end": 79592,
   "dur": 1.4,
   "speaker": "Gillian",
   "en": "Джейми.",
   "enabled": true,
   "en_src": "Jamie."
  },
  {
   "id": "B1F0_j_12",
   "file": 4,
   "chan": 4,
   "start": 79592,
   "end": 80437,
   "dur": 8.5,
   "speaker": "Jamie",
   "en": "Я ушла, потому что думала, что ты себя заставляешь,",
   "enabled": true,
   "en_src": "I left because I thought you were forcing yourself,"
  },
  {
   "id": "B1F0_j_12b",
   "file": 4,
   "chan": 4,
   "start": 80437,
   "end": 80885,
   "dur": 3.5,
   "speaker": "Jamie",
   "en": "вернее, я это чувствовала.",
   "enabled": true,
   "en_src": "or rather, I felt it."
  },
  {
   "id": "B1F0_j_12c",
   "file": 4,
   "chan": 4,
   "start": 80885,
   "end": 81378,
   "dur": 6.5,
   "speaker": "Jamie",
   "en": "Я думала, что обручальные кольца, что были на нас,",
   "enabled": true,
   "en_src": "I wondered if the wedding rings we wore"
  },
  {
   "id": "B1F0_j_12d",
   "file": 4,
   "chan": 4,
   "start": 81378,
   "end": 82201,
   "dur": 7.7,
   "speaker": "Jamie",
   "en": "когда нас нашли, стали для тебя обузой.",
   "enabled": true,
   "en_src": "when we were found had become a burden to you."
  },
  {
   "id": "B1F0_j_12e",
   "file": 4,
   "chan": 4,
   "start": 82201,
   "end": 82939,
   "dur": 9.7,
   "speaker": "Jamie",
   "en": "Если нас держат вместе лишь кольца, это слишком грустно.",
   "enabled": true,
   "en_src": "If only those rings kept us together, it would be too sad."
  },
  {
   "id": "B1F0_j_16",
   "file": 4,
   "chan": 4,
   "start": 82939,
   "end": 83167,
   "dur": 1.5,
   "speaker": "Gillian",
   "en": "Это не так.",
   "enabled": true,
   "en_src": "That's not true."
  },
  {
   "id": "B1F0_j_17",
   "file": 4,
   "chan": 4,
   "start": 83167,
   "end": 83530,
   "dur": 3.3,
   "speaker": "Jamie",
   "en": "Я буду ждать, Гиллиан.",
   "enabled": true,
   "en_src": "I'll be waiting, Gillian."
  },
  {
   "id": "B1F0_j_17b",
   "file": 4,
   "chan": 4,
   "start": 83530,
   "end": 83723,
   "dur": 2.7,
   "speaker": "Jamie",
   "en": "Пусть мы и не помним,",
   "enabled": true,
   "en_src": "We may not remember,"
  },
  {
   "id": "B1F0_j_17c",
   "file": 4,
   "chan": 4,
   "start": 83723,
   "end": 84687,
   "dur": 7.5,
   "speaker": "Jamie",
   "en": "но ты - единственный, с кем я разделила то время.",
   "enabled": true,
   "en_src": "but you're the only person who shared that time with me."
  },
  {
   "id": "B1F0_j_17d",
   "file": 4,
   "chan": 4,
   "start": 84687,
   "end": 85551,
   "dur": 2.5,
   "speaker": "Jamie",
   "en": "Береги себя, Гиллиан.",
   "enabled": true,
   "en_src": "Take care, Gillian."
  },
  {
   "id": "B1F0_j_19",
   "file": 4,
   "chan": 4,
   "start": 85551,
   "end": 85719,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Джейми.",
   "enabled": true,
   "en_src": "Jamie."
  },
  {
   "id": "B1F0_j_20",
   "file": 4,
   "chan": 4,
   "start": 85719,
   "end": 86003,
   "dur": 1.9,
   "speaker": "Metal Gear",
   "en": "И ты так всё и оставишь?",
   "enabled": true,
   "en_src": "Are you going to leave it at that?"
  },
  {
   "id": "B1F0_j_21",
   "file": 4,
   "chan": 4,
   "start": 86003,
   "end": 86868,
   "dur": 5.8,
   "speaker": "Gillian",
   "en": "Поехали, Метал. В больницу \"Куин\". Её Величество ждёт.",
   "enabled": true,
   "last": true,
   "en_src": "Let's go, Metal. To Queen Hospital. Her Majesty awaits."
  },
  {
   "id": "B1F0_t_00",
   "file": 1,
   "chan": 3,
   "start": 65954,
   "end": 66538,
   "dur": 3.9,
   "speaker": "Randam",
   "en": "Гиллиан! Неужели не успел?",
   "enabled": true,
   "en_src": "Gillian! He didn't make it?"
  },
  {
   "id": "B1F0_t_01",
   "file": 1,
   "chan": 3,
   "start": 66538,
   "end": 67436,
   "dur": 6.0,
   "speaker": "Gillian",
   "en": "Не дождёшься! Я здесь!",
   "enabled": true,
   "en_src": "Don't be stupid! I'm right here!"
  },
  {
   "id": "B1F0_t_02",
   "file": 1,
   "chan": 3,
   "start": 67436,
   "end": 67960,
   "dur": 3.5,
   "speaker": "Randam",
   "en": "Гиллиан, ты что, на велике кататься не умеешь?",
   "enabled": true,
   "en_src": "Gillian, don't you know how to ride a bike?"
  },
  {
   "id": "B1F0_t_03",
   "file": 1,
   "chan": 3,
   "start": 67960,
   "end": 68417,
   "dur": 3.1,
   "speaker": "Metal Gear",
   "en": "Мы почти у больницы \"Куин\", Гиллиан.",
   "enabled": true,
   "en_src": "We're almost at Queen Hospital, Gillian."
  },
  {
   "id": "B1F0_t_04",
   "file": 1,
   "chan": 3,
   "start": 68417,
   "end": 69339,
   "dur": 6.2,
   "speaker": "Metal Gear",
   "en": "Тебе полезно размяться, так что едем дальше так.",
   "enabled": true,
   "last": true,
   "en_src": "You could use the exercise, so let's keep going like this."
  }
 ]
}
