{
 "scene": "B0D0",
 "cues": [
  {
   "id": "B0D0_000",
   "file": 53,
   "chan": 0,
   "start": 41272,
   "end": 41688,
   "dur": 2.8,
   "speaker": "Napoleon",
   "en": "Так ты новый ДЖАНКЕР.",
   "enabled": true,
   "en_src": "So you're the new JUNKER."
  },
  {
   "id": "B0D0_001",
   "file": 54,
   "chan": 0,
   "start": 41704,
   "end": 41864,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Ты Наполеон?",
   "enabled": true,
   "en_src": "You're Napoleon?"
  },
  {
   "id": "B0D0_002",
   "file": 55,
   "chan": 0,
   "start": 41880,
   "end": 42189,
   "dur": 1.8,
   "speaker": "Napoleon",
   "en": "Давай быстрее.",
   "enabled": true,
   "en_src": "Make it quick."
  },
  {
   "id": "B0D0_002b",
   "file": 55,
   "chan": 0,
   "start": 42189,
   "end": 42744,
   "dur": 7.7,
   "speaker": "Napoleon",
   "en": "Если снатчеры увидят меня тут, я буду следующим.",
   "enabled": true,
   "last": true,
   "en_src": "If the Snatchers see me here, I'll be the next one they kill."
  },
  {
   "id": "B0D0_1021",
   "file": 56,
   "chan": 0,
   "start": 42760,
   "end": 42968,
   "dur": 1.4,
   "speaker": "Gillian",
   "en": "Ладно, погадаю.",
   "enabled": true,
   "en_src": "All right, I'll get a reading."
  },
  {
   "id": "B0D0_1022",
   "file": 57,
   "chan": 0,
   "start": 42984,
   "end": 43160,
   "dur": 1.2,
   "speaker": "Metal Gear",
   "en": "Встанем в очередь.",
   "enabled": true,
   "by_text": true,
   "en_src": "Let's join the line."
  },
  {
   "id": "B0D0_1023",
   "file": 58,
   "chan": 0,
   "start": 43176,
   "end": 43384,
   "dur": 1.4,
   "speaker": "Teller",
   "en": "Следующий!",
   "enabled": true,
   "en_src": "Next, please!"
  },
  {
   "id": "B0D0_1024",
   "file": 59,
   "chan": 0,
   "start": 43400,
   "end": 43480,
   "dur": 0.5,
   "speaker": "Gillian",
   "en": "Д-да.",
   "enabled": true,
   "en_src": "Y-yes."
  },
  {
   "id": "B0D0_1025",
   "file": 60,
   "chan": 0,
   "start": 43496,
   "end": 44046,
   "dur": 3.7,
   "speaker": "Teller",
   "en": "Положите сюда лицо и смотрите прямо.",
   "enabled": true,
   "en_src": "Rest your face here and look straight ahead."
  },
  {
   "id": "B0D0_1025b",
   "file": 60,
   "chan": 0,
   "start": 44180,
   "end": 44700,
   "dur": 3.5,
   "speaker": "Teller",
   "en": "Рисунок вашей сетчатки записан.",
   "enabled": true,
   "en_src": "I've recorded your retinal pattern."
  },
  {
   "id": "B0D0_1025c",
   "file": 60,
   "chan": 0,
   "start": 44819,
   "end": 45304,
   "dur": 3.2,
   "speaker": "Teller",
   "en": "О чём хотите спросить?",
   "enabled": true,
   "en_src": "What would you like to ask about?"
  },
  {
   "id": "B0D0_1026",
   "file": 61,
   "chan": 0,
   "start": 45320,
   "end": 45656,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Ну, может, о браке?",
   "enabled": true,
   "en_src": "Well, how about marriage?"
  },
  {
   "id": "B0D0_1027",
   "file": 62,
   "chan": 0,
   "start": 45672,
   "end": 45896,
   "dur": 1.5,
   "speaker": "Metal Gear",
   "en": "О браке, Гиллиан?",
   "enabled": true,
   "by_text": true,
   "en_src": "Marriage, Gillian?"
  },
  {
   "id": "B0D0_1028",
   "file": 63,
   "chan": 0,
   "start": 45912,
   "end": 46152,
   "dur": 1.6,
   "speaker": "Gillian",
   "en": "Всё нормально! Не волнуйся!",
   "enabled": true,
   "en_src": "It's fine! Don't worry!"
  },
  {
   "id": "B0D0_1029",
   "file": 64,
   "chan": 0,
   "start": 46168,
   "end": 46984,
   "dur": 5.4,
   "speaker": "Teller",
   "en": "Брак. Давайте посмотрим.",
   "enabled": true,
   "en_src": "Marriage. Let's have a look."
  },
  {
   "id": "B0D0_1030",
   "file": 65,
   "chan": 0,
   "start": 47000,
   "end": 47608,
   "dur": 3.8,
   "speaker": "Teller",
   "en": "Хм... Вот оно!",
   "enabled": true,
   "en_src": "Mmm... There it is!"
  },
  {
   "id": "B0D0_1031",
   "file": 66,
   "chan": 0,
   "start": 47624,
   "end": 47752,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Ну?",
   "enabled": true,
   "en_src": "Well?"
  },
  {
   "id": "B0D0_1032",
   "file": 67,
   "chan": 0,
   "start": 47768,
   "end": 48088,
   "dur": 2.1,
   "speaker": "Teller",
   "en": "Ваша линия брака нарушена.",
   "enabled": true,
   "en_src": "Your marriage line is disturbed."
  },
  {
   "id": "B0D0_1033",
   "file": 68,
   "chan": 0,
   "start": 48104,
   "end": 48360,
   "dur": 1.7,
   "speaker": "Gillian",
   "en": "Ха-ха. Нарушена?",
   "enabled": true,
   "en_src": "Ha ha. Disturbed?"
  },
  {
   "id": "B0D0_1034",
   "file": 69,
   "chan": 0,
   "start": 48376,
   "end": 49160,
   "dur": 5.2,
   "speaker": "Teller",
   "en": "Развод, разлука... Ваш брак разладился.",
   "enabled": true,
   "en_src": "Divorce, separation... Your marriage has gone wrong."
  },
  {
   "id": "B0D0_1035",
   "file": 70,
   "chan": 0,
   "start": 49176,
   "end": 49544,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Правда? Может, мне показалось.",
   "enabled": true,
   "last": true,
   "en_src": "Really? Maybe it's my imagination."
  },
  {
   "id": "B0D0_1036",
   "file": 1,
   "chan": 1,
   "start": 2409,
   "end": 2569,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Глоть!",
   "enabled": true,
   "en_src": "Gulp!"
  },
  {
   "id": "B0D0_1037",
   "file": 2,
   "chan": 1,
   "start": 2585,
   "end": 3561,
   "dur": 6.5,
   "speaker": "Teller",
   "en": "А ещё вы... Да, вы потеряли память.",
   "enabled": true,
   "en_src": "And you... Yes, you've lost your memory."
  },
  {
   "id": "B0D0_1038",
   "file": 3,
   "chan": 1,
   "start": 3577,
   "end": 3705,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Откуда вы знаете?",
   "enabled": true,
   "en_src": "How did you know?"
  },
  {
   "id": "B0D0_1039",
   "file": 4,
   "chan": 1,
   "start": 3721,
   "end": 4217,
   "dur": 3.3,
   "speaker": "Teller",
   "en": "Сетчатка раскрывает всё.",
   "enabled": true,
   "en_src": "Retinal readings reveal everything."
  },
  {
   "id": "B0D0_1040",
   "file": 5,
   "chan": 1,
   "start": 4233,
   "end": 4569,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Тогда как мне наладить всё с ней?",
   "enabled": true,
   "en_src": "Then how can I make things work with her?"
  },
  {
   "id": "B0D0_1041",
   "file": 6,
   "chan": 1,
   "start": 4585,
   "end": 5625,
   "dur": 6.9,
   "speaker": "Teller",
   "en": "Это зависит от вас. Нет воспоминаний - создайте новые.",
   "enabled": true,
   "en_src": "That's up to you. If you have no memories, make new ones."
  },
  {
   "id": "B0D0_1042",
   "file": 7,
   "chan": 1,
   "start": 5641,
   "end": 6009,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Так просто?",
   "enabled": true,
   "en_src": "Is it that simple?"
  },
  {
   "id": "B0D0_1043",
   "file": 8,
   "chan": 1,
   "start": 6025,
   "end": 6442,
   "dur": 2.8,
   "speaker": "Teller",
   "en": "Своё будущее вы творите сами!",
   "enabled": true,
   "en_src": "You make your own future!"
  },
  {
   "id": "B0D0_1043b",
   "file": 8,
   "chan": 1,
   "start": 6554,
   "end": 6673,
   "dur": 0.8,
   "speaker": "Teller",
   "en": "Хм?",
   "enabled": true,
   "en_src": "Hmm?"
  },
  {
   "id": "B0D0_1043c",
   "file": 8,
   "chan": 1,
   "start": 6823,
   "end": 7129,
   "dur": 2.0,
   "speaker": "Teller",
   "en": "Следующий!",
   "enabled": true,
   "en_src": "Next, please!"
  },
  {
   "id": "B0D0_1044",
   "file": 9,
   "chan": 1,
   "start": 7145,
   "end": 7305,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Спасибо.",
   "enabled": true,
   "en_src": "Thank you."
  },
  {
   "id": "B0D0_1045",
   "file": 10,
   "chan": 1,
   "start": 7321,
   "end": 7961,
   "dur": 8.6,
   "speaker": "Gillian",
   "en": "Слыхал, Метал? Я не верил гаданиям, но это впечатляет.",
   "enabled": true,
   "en_src": "Hear that, Metal? I doubted fortune-telling, but that was impressive."
  },
  {
   "id": "B0D0_1046",
   "file": 11,
   "chan": 1,
   "start": 7977,
   "end": 8489,
   "dur": 3.4,
   "speaker": "Metal Gear",
   "en": "Гиллиан, ты правда ей поверил?",
   "enabled": true,
   "by_text": true,
   "en_src": "Gillian, did you really believe her?"
  },
  {
   "id": "B0D0_1047",
   "file": 12,
   "chan": 1,
   "start": 8505,
   "end": 8825,
   "dur": 2.1,
   "speaker": "Gillian",
   "en": "Конечно. Она столько угадала.",
   "enabled": true,
   "en_src": "Of course. She got so much right."
  },
  {
   "id": "B0D0_1048",
   "file": 13,
   "chan": 1,
   "start": 8841,
   "end": 9417,
   "dur": 3.8,
   "speaker": "Metal Gear",
   "en": "Это любой может. Она ведь считала твою сетчатку?",
   "enabled": true,
   "by_text": true,
   "en_src": "Anyone could do that. She read your retinal pattern, didn't she?"
  },
  {
   "id": "B0D0_1049",
   "file": 14,
   "chan": 1,
   "start": 9433,
   "end": 9593,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "И что?",
   "enabled": true,
   "en_src": "So what?"
  },
  {
   "id": "B0D0_1050",
   "file": 15,
   "chan": 1,
   "start": 9609,
   "end": 10204,
   "dur": 7.8,
   "speaker": "Metal Gear",
   "en": "Рисунок сетчатки каждого записан в \"Альфавиле\".",
   "enabled": true,
   "by_text": true,
   "en_src": "Everyone's retinal pattern is registered in Alphaville."
  },
  {
   "id": "B0D0_1050b",
   "file": 15,
   "chan": 1,
   "start": 10204,
   "end": 10502,
   "dur": 2.7,
   "speaker": "Metal Gear",
   "en": "И твой тоже, Гиллиан.",
   "enabled": true,
   "by_text": true,
   "en_src": "Yours too, Gillian."
  },
  {
   "id": "B0D0_1050c",
   "file": 15,
   "chan": 1,
   "start": 10502,
   "end": 11101,
   "dur": 5.0,
   "speaker": "Metal Gear",
   "en": "Она отсканировала твою сетчатку",
   "enabled": true,
   "by_text": true,
   "en_src": "She scanned your retina and used it"
  },
  {
   "id": "B0D0_1050d",
   "file": 15,
   "chan": 1,
   "start": 11101,
   "end": 11625,
   "dur": 5.7,
   "speaker": "Metal Gear",
   "en": "и нашла твои данные в базе.",
   "enabled": true,
   "by_text": true,
   "en_src": "to look up your details in the databank."
  },
  {
   "id": "B0D0_1051",
   "file": 16,
   "chan": 1,
   "start": 11641,
   "end": 12569,
   "dur": 6.2,
   "speaker": "Metal Gear",
   "en": "Никакого гадания. Она посмотрела твоё досье. Обычный хакер.",
   "enabled": true,
   "by_text": true,
   "en_src": "No fortune-telling. She checked your records. She's just a hacker."
  },
  {
   "id": "B0D0_1052",
   "file": 17,
   "chan": 1,
   "start": 12585,
   "end": 12969,
   "dur": 2.6,
   "speaker": "Gillian",
   "en": "А как же я? Как же мы с Джейми?",
   "enabled": true,
   "en_src": "Then what about me? What about Jamie and me?"
  },
  {
   "id": "B0D0_1053",
   "file": 18,
   "chan": 1,
   "start": 12985,
   "end": 13625,
   "dur": 4.3,
   "speaker": "Metal Gear",
   "en": "Как она и сказала, будущее ты творишь сам.",
   "enabled": true,
   "last": true,
   "by_text": true,
   "en_src": "As she said, you make your own future."
  }
 ],
 "options": {
  "faceleft": true,
  "cols": 12
 }
}
