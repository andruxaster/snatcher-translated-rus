{
 "scene": "B120",
 "cues": [
  {
   "id": "B120_000",
   "file": 50,
   "chan": 0,
   "start": 39704,
   "end": 40248,
   "dur": 3.6,
   "speaker": "Lisa",
   "en": "Так вот вы какой? Вон! И не возвращайтесь!",
   "enabled": true,
   "en_src": "So that's what you're like? Get out! Don't come back!"
  },
  {
   "id": "B120_001",
   "file": 51,
   "chan": 0,
   "start": 40264,
   "end": 40852,
   "dur": 3.9,
   "speaker": "Gillian",
   "en": "Оставлю вам адрес и номер видеофона, на всякий случай.",
   "enabled": true,
   "en_src": "I'll give you my address and videophone number, just in case."
  },
  {
   "id": "B120_001b",
   "file": 51,
   "chan": 0,
   "start": 40852,
   "end": 41048,
   "dur": 1.3,
   "speaker": "Gillian",
   "en": "Если что-то случится, звоните.",
   "enabled": true,
   "en_src": "Call me if anything happens."
  },
  {
   "id": "B120_002",
   "file": 52,
   "chan": 0,
   "start": 41064,
   "end": 41256,
   "dur": 1.3,
   "speaker": "Lisa",
   "en": "Спасибо. До свидания.",
   "enabled": true,
   "last": true,
   "en_src": "Thank you. Goodbye."
  },
  {
   "id": "B120_f21_0",
   "file": 21,
   "chan": 2,
   "start": 17898,
   "end": 18506,
   "dur": 4.1,
   "speaker": "Lisa",
   "en": "ДЖАНКЕР? Хорошо. Я открою.",
   "enabled": true,
   "en_src": "JUNKER? All right. I'll open the door."
  },
  {
   "id": "B120_f22_0",
   "file": 22,
   "chan": 2,
   "start": 18522,
   "end": 18794,
   "dur": 1.8,
   "speaker": "Metal Gear",
   "en": "Осторожно, Гиллиан.",
   "enabled": true,
   "en_src": "Be careful, Gillian."
  },
  {
   "id": "B120_f23_0",
   "file": 23,
   "chan": 2,
   "start": 18810,
   "end": 19098,
   "dur": 1.9,
   "speaker": "Gillian",
   "en": "О, это женщина.",
   "enabled": true,
   "en_src": "Oh, it's a woman."
  },
  {
   "id": "B120_f24_0",
   "file": 24,
   "chan": 2,
   "start": 19114,
   "end": 19946,
   "dur": 11.0,
   "speaker": "Gillian",
   "en": "Хм. Одно это не доказывает, что Фредди Нильсен - снатчер.",
   "enabled": true,
   "en_src": "Hmm. This alone does not prove that Freddy Nielsen is a Snatcher."
  },
  {
   "id": "B120_f25_0",
   "file": 25,
   "chan": 2,
   "start": 19962,
   "end": 20554,
   "dur": 7.8,
   "speaker": "Metal Gear",
   "en": "Да. Для ордера на сканирование нужны улики.",
   "enabled": true,
   "en_src": "Right. We need evidence to get a scanning warrant."
  },
  {
   "id": "B120_f26_0",
   "file": 26,
   "chan": 2,
   "start": 20570,
   "end": 20794,
   "dur": 1.5,
   "speaker": "Gillian",
   "en": "Я бы хотел осмотреть ванную.",
   "enabled": true,
   "en_src": "I'd like to see the bathroom."
  },
  {
   "id": "B120_f27_0",
   "file": 27,
   "chan": 2,
   "start": 20810,
   "end": 20954,
   "dur": 1.0,
   "speaker": "Lisa",
   "en": "Ой, вам в туалет?",
   "enabled": true,
   "en_src": "Oh, need the toilet?"
  },
  {
   "id": "B120_f28_0",
   "file": 28,
   "chan": 2,
   "start": 20970,
   "end": 21562,
   "dur": 3.9,
   "speaker": "Metal Gear",
   "en": "Нет-нет. Мы хотим осмотреть вашу ванную.",
   "enabled": true,
   "en_src": "No, no. We'd like to inspect your bathroom."
  },
  {
   "id": "B120_f29_0",
   "file": 29,
   "chan": 2,
   "start": 21578,
   "end": 21786,
   "dur": 1.4,
   "speaker": "Lisa",
   "en": "Пожалуйста.",
   "enabled": true,
   "en_src": "Go ahead."
  },
  {
   "id": "B120_f30_0",
   "file": 30,
   "chan": 2,
   "start": 21802,
   "end": 22425,
   "dur": 4.2,
   "speaker": "Metal Gear",
   "en": "Сомнений нет. Фредди Нильсен - снатчер.",
   "enabled": true,
   "en_src": "There's no doubt. Freddy Nielsen is a Snatcher."
  },
  {
   "id": "B120_f30_0b",
   "file": 30,
   "chan": 2,
   "start": 22425,
   "end": 22968,
   "dur": 3.6,
   "speaker": "Metal Gear",
   "en": "С такими косвенными уликами",
   "enabled": true,
   "en_src": "With this much circumstantial evidence,"
  },
  {
   "id": "B120_f30_0c",
   "file": 30,
   "chan": 2,
   "start": 22968,
   "end": 23466,
   "dur": 3.4,
   "speaker": "Metal Gear",
   "en": "мы получим ордер на сканирование Фредди, Гиллиан.",
   "enabled": true,
   "en_src": "we can get a warrant to scan Freddy, Gillian."
  },
  {
   "id": "B120_f31_0",
   "file": 31,
   "chan": 2,
   "start": 23482,
   "end": 23786,
   "dur": 2.0,
   "speaker": "Gillian",
   "en": "Наконец-то я нашёл тебя, снатчер!",
   "enabled": true,
   "en_src": "I've finally found you, Snatcher!"
  },
  {
   "id": "B120_f32_0",
   "file": 32,
   "chan": 2,
   "start": 23802,
   "end": 23882,
   "dur": 0.5,
   "speaker": "Lisa",
   "en": "Ты видел.",
   "enabled": true,
   "en_src": "You saw it."
  },
  {
   "id": "B120_f33_0",
   "file": 33,
   "chan": 2,
   "start": 23898,
   "end": 23930,
   "dur": 0.2,
   "speaker": "Gillian",
   "en": "Кто здесь?!",
   "enabled": true,
   "en_src": "Who's there?!"
  },
  {
   "id": "B120_f34_0",
   "file": 34,
   "chan": 2,
   "start": 23946,
   "end": 24106,
   "dur": 1.1,
   "speaker": "Lisa",
   "en": "Ты видел, ДЖАНКЕР!",
   "enabled": true,
   "en_src": "You saw it, JUNKER!"
  },
  {
   "id": "B120_f35_0",
   "file": 35,
   "chan": 2,
   "start": 24122,
   "end": 24250,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "Эти царапины!",
   "enabled": true,
   "en_src": "Those scratches!"
  },
  {
   "id": "B120_f36_0",
   "file": 36,
   "chan": 2,
   "start": 24266,
   "end": 24474,
   "dur": 1.4,
   "speaker": "Metal Gear",
   "en": "Это Жан оставил!",
   "enabled": true,
   "en_src": "Jean made those!"
  },
  {
   "id": "B120_f37_0",
   "file": 37,
   "chan": 2,
   "start": 24490,
   "end": 24746,
   "dur": 1.7,
   "speaker": "Lisa",
   "en": "Ты умрёшь, ДЖАНКЕР!",
   "enabled": true,
   "en_src": "You're going to die, JUNKER!"
  },
  {
   "id": "B120_f38_0",
   "file": 38,
   "chan": 2,
   "start": 24762,
   "end": 25242,
   "dur": 3.2,
   "speaker": "Gillian",
   "en": "Живучая тварь. Так вот он какой, снатчер.",
   "enabled": true,
   "en_src": "Tough bastard. So this is a Snatcher."
  },
  {
   "id": "B120_f39_0",
   "file": 39,
   "chan": 2,
   "start": 25258,
   "end": 25578,
   "dur": 2.1,
   "speaker": "Metal Gear",
   "en": "Она точно мертва?",
   "enabled": true,
   "en_src": "Is it really dead?"
  },
  {
   "id": "B120_f40_0",
   "file": 40,
   "chan": 2,
   "start": 25594,
   "end": 25994,
   "dur": 2.7,
   "speaker": "Metal Gear",
   "en": "Это Лиза и Фредди убили Жана?",
   "enabled": true,
   "en_src": "Did Lisa and Freddy kill Jean?"
  },
  {
   "id": "B120_f41_0",
   "file": 41,
   "chan": 2,
   "start": 26010,
   "end": 26314,
   "dur": 2.0,
   "speaker": "Gillian",
   "en": "Фредди? Где он?",
   "enabled": true,
   "en_src": "Freddy? Where is he?"
  },
  {
   "id": "B120_f42_0",
   "file": 42,
   "chan": 2,
   "start": 26330,
   "end": 26621,
   "dur": 1.9,
   "speaker": "Metal Gear",
   "en": "Мусорщиков вызовем позже.",
   "enabled": true,
   "en_src": "We'll call the junk disposal team later."
  },
  {
   "id": "B120_f42_0b",
   "file": 42,
   "chan": 2,
   "start": 26621,
   "end": 26842,
   "dur": 1.5,
   "speaker": "Metal Gear",
   "en": "А пока выйдем наружу.",
   "enabled": true,
   "en_src": "Let's go outside for now."
  },
  {
   "id": "B120_f43_0",
   "file": 43,
   "chan": 2,
   "start": 26858,
   "end": 27002,
   "dur": 1.0,
   "speaker": "Gillian",
   "en": "Мы снаружи.",
   "enabled": true,
   "en_src": "We're outside."
  },
  {
   "id": "B120_f44_0",
   "file": 44,
   "chan": 2,
   "start": 27018,
   "end": 27722,
   "dur": 4.7,
   "speaker": "Gillian",
   "en": "Свет зажёгся! А внутри никого не должно быть.",
   "enabled": true,
   "en_src": "The lights came on! No one's supposed to be inside."
  },
  {
   "id": "B120_f45_0",
   "file": 45,
   "chan": 2,
   "start": 27738,
   "end": 28090,
   "dur": 2.3,
   "speaker": "Metal Gear",
   "en": "Может, Фредди вернулся домой?",
   "enabled": true,
   "en_src": "Could Freddy have come home?"
  },
  {
   "id": "B120_f46_0",
   "file": 46,
   "chan": 2,
   "start": 28106,
   "end": 28398,
   "dur": 1.9,
   "speaker": "Gillian",
   "en": "Других входов и выходов тут нет.",
   "enabled": true,
   "en_src": "This should be the only way in or out."
  },
  {
   "id": "B120_f46_0b",
   "file": 46,
   "chan": 2,
   "start": 28509,
   "end": 28714,
   "dur": 1.4,
   "speaker": "Gillian",
   "en": "Как он попал внутрь?",
   "enabled": true,
   "en_src": "How did he get inside?"
  },
  {
   "id": "B120_f47_0",
   "file": 47,
   "chan": 2,
   "start": 28730,
   "end": 28858,
   "dur": 0.9,
   "speaker": "Metal Gear",
   "en": "Проверим!",
   "enabled": true,
   "last": true,
   "en_src": "Let's check it out!"
  },
  {
   "id": "B120_f12_0",
   "file": 12,
   "chan": 4,
   "start": 10812,
   "end": 11084,
   "dur": 1.8,
   "speaker": "Gillian",
   "en": "Метал, взломай замок!",
   "enabled": true,
   "en_src": "Metal, force the lock!"
  },
  {
   "id": "B120_f13_0",
   "file": 13,
   "chan": 4,
   "start": 11100,
   "end": 11178,
   "dur": 1.6,
   "speaker": "Metal Gear",
   "en": "Понял.",
   "enabled": true,
   "en_src": "Understood."
  },
  {
   "id": "B120_f13_0b",
   "file": 13,
   "chan": 4,
   "start": 11178,
   "end": 11884,
   "dur": 8.8,
   "speaker": "Metal Gear",
   "en": "Ищу в \"Альфавиле\" код замка квартиры 202.",
   "enabled": true,
   "en_src": "I will search Alphaville for apartment 202's electronic lock code."
  },
  {
   "id": "B120_f14_0",
   "file": 14,
   "chan": 4,
   "start": 11900,
   "end": 12060,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Быстрее, Метал!",
   "enabled": true,
   "en_src": "Hurry, Metal!"
  },
  {
   "id": "B120_f15_0",
   "file": 15,
   "chan": 4,
   "start": 12076,
   "end": 12371,
   "dur": 2.0,
   "speaker": "Metal Gear",
   "en": "Почти готово.",
   "enabled": true,
   "en_src": "Almost there."
  },
  {
   "id": "B120_f15_0b",
   "file": 15,
   "chan": 4,
   "start": 12519,
   "end": 13068,
   "dur": 3.7,
   "speaker": "Metal Gear",
   "en": "Вхожу в зону управления района MR в \"Альфавиле\".",
   "enabled": true,
   "en_src": "Entering Alphaville's MR district management area."
  },
  {
   "id": "B120_f16_0",
   "file": 16,
   "chan": 4,
   "start": 13084,
   "end": 13372,
   "dur": 1.9,
   "speaker": "Metal Gear",
   "en": "Код найден. Открываю дверь.",
   "enabled": true,
   "en_src": "Code found. Opening the door."
  },
  {
   "id": "B120_f17_0",
   "file": 17,
   "chan": 4,
   "start": 13388,
   "end": 13468,
   "dur": 0.5,
   "speaker": "Gillian",
   "en": "Отлично!",
   "enabled": true,
   "en_src": "Good!"
  },
  {
   "id": "B120_f18_0",
   "file": 18,
   "chan": 4,
   "start": 13484,
   "end": 14252,
   "dur": 5.1,
   "speaker": "Gillian",
   "en": "Ванна пуста! Только что была полна воды.",
   "enabled": true,
   "en_src": "The tub's empty! It was full of water a moment ago."
  },
  {
   "id": "B120_f19_0",
   "file": 19,
   "chan": 4,
   "start": 14268,
   "end": 14588,
   "dur": 2.1,
   "speaker": "Metal Gear",
   "en": "Движение обнаружено! Оно в этой комнате.",
   "enabled": true,
   "en_src": "Movement detected! It's in this room."
  },
  {
   "id": "B120_f20_0",
   "file": 20,
   "chan": 4,
   "start": 14604,
   "end": 14828,
   "dur": 1.5,
   "speaker": "Gillian",
   "en": "Где оно? Где эта тварь?",
   "enabled": true,
   "en_src": "Where is it? Where is that thing?"
  },
  {
   "id": "B120_f21_0b",
   "file": 21,
   "chan": 4,
   "start": 14844,
   "end": 14972,
   "dur": 0.9,
   "speaker": "Metal Gear",
   "en": "Гиллиан, берегись!",
   "enabled": true,
   "last": true,
   "en_src": "Gillian, look out!"
  },
  {
   "id": "B120_c4f22",
   "file": 22,
   "chan": 4,
   "start": 14988,
   "end": 15132,
   "dur": 1.0,
   "speaker": "Gillian",
   "en": "Ай!",
   "enabled": true,
   "en_src": "Ow!"
  }
 ],
 "options": {
  "faceleft": true,
  "cols": 12
 }
}
