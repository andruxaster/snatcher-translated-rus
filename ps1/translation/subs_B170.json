   "dur": 2.6,
   "speaker": "Metal Gear",
   "en": "Экстренный вызов из штаба. Соединяю.",
   "enabled": true,
   "en_src": "An emergency call from headquarters. I'll put it through."
  },
  {
   "id": "B170_f15_0",
   "file": 15,
   "chan": 5,
   "start": 10125,
   "end": 10434,
   "dur": 2.0,
   "speaker": "Mika",
   "en": "Гиллиан, наконец-то я до вас дозвонилась!",
   "enabled": true,
   "en_src": "Gillian, I finally reached you!"
  },
  {
   "id": "B170_f15_0b",
   "file": 15,
   "chan": 5,
   "start": 10434,
   "end": 10734,
   "dur": 2.1,
   "speaker": "Mika",
   "en": "Недавно звонила Кэтрин.",
   "enabled": true,
   "en_src": "Catherine called a little while ago."
  },
  {
   "id": "B170_f15_0c",
   "file": 15,
   "chan": 5,
   "start": 10734,
   "end": 11069,
   "dur": 2.2,
   "speaker": "Mika",
   "en": "Сказала, что хочет кое-что вам передать.",
   "enabled": true,
   "en_src": "She said she has something to give you."
  },
  {
   "id": "B170_f16_0",
   "file": 16,
   "chan": 5,
   "start": 11085,
   "end": 11421,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Мне? Что бы это могло быть?",
   "enabled": true,
   "en_src": "Something for me? What could it be?"
  },
  {
   "id": "B170_f17_0",
   "file": 17,
   "chan": 5,
   "start": 11437,
   "end": 12013,
   "dur": 3.8,
   "speaker": "Mika",
   "en": "Она была в ужасе. Сказала, что Элис лает.",
   "enabled": true,
   "en_src": "She sounded terrified. She said Alice was barking."
  },
  {
   "id": "B170_f18_0",
   "file": 18,
   "chan": 5,
   "start": 12029,
   "end": 12125,
   "dur": 0.6,
   "speaker": "Gillian",
   "en": "Когда это было?!",
   "enabled": true,
   "en_src": "When was this?!"
  },
  {
   "id": "B170_f19_0",
   "file": 19,
   "chan": 5,
   "start": 12141,
   "end": 12445,
   "dur": 2.0,
   "speaker": "Mika",
   "en": "Минут тридцать назад.",
   "enabled": true,
   "en_src": "About thirty minutes ago."
  },
  {
   "id": "B170_f20_0",
   "file": 20,
   "chan": 5,
   "start": 12461,
   "end": 12541,
   "dur": 0.5,
   "speaker": "Gillian",
   "en": "Чёрт!",
   "enabled": true,
   "en_src": "Damn!"
  },
  {
   "id": "B170_f21_0",
   "file": 21,
   "chan": 5,
   "start": 12557,
   "end": 12749,
   "dur": 1.3,
   "speaker": "Metal Gear",
   "en": "Гиллиан, скорее!",
   "enabled": true,
   "en_src": "Gillian, hurry!"
  },
  {
   "id": "B170_f22_0",
   "file": 22,
   "chan": 5,
   "start": 12765,
   "end": 12877,
   "dur": 0.7,
   "speaker": "Gillian",
   "en": "Кэтрин в опасности!",
   "enabled": true,
   "last": true,
   "en_src": "Catherine's in danger!"
  },
  {
   "id": "B170_r_00",
   "file": 1,
   "chan": 3,
   "start": 64891,
   "end": 65490,
   "dur": 4.0,
   "speaker": "Gillian",
   "en": "Gillian! ...No good, was it?",
   "enabled": false
  },
  {
   "id": "B170_r_01",
   "file": 1,
   "chan": 3,
   "start": 65490,
   "end": 66388,
   "dur": 6.0,
   "speaker": "Randam",
   "en": "Гиллиан! Не успел?",
   "enabled": true,
   "en_src": "Gillian! Didn't make it?"
  },
  {
   "id": "B170_r_02",
   "file": 1,
   "chan": 3,
   "start": 66388,
   "end": 66912,
   "dur": 3.5,
   "speaker": "Gillian",
   "en": "Не смеши! Я здесь!",
   "enabled": true,
   "en_src": "Don't be ridiculous! I'm right here!"
  },
  {
   "id": "B170_r_03",
   "file": 1,
   "chan": 3,
   "start": 66912,
   "end": 67362,
   "dur": 3.0,
   "speaker": "Metal Gear",
   "en": "Gillian, it's not far now to Queen Hospital.",
